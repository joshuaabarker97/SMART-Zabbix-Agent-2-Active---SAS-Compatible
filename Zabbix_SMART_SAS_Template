zabbix_export:
  version: '7.0'
  template_groups:
    - uuid: b80c5c0db3124cce87edaffe13d900f0
      name: Storage
    - uuid: 7df96b18c230490a9a0a9e2307226338
      name: Templates
  templates:
    - uuid: 3d9aad51f0b14d2f8b2af345e34daaa8
      template: 'SMART Zabbix Agent 2 Active - SAS Compatible'
      name: 'SMART Zabbix Agent 2 Active - SAS Compatible'
      description: |
        A custom Zabbix 7.0 template built on the legacy SMART by Agent 2 template, adapted and designed to provide reliable SMART monitoring for SAS drives, while also supporting SATA and NVMe storage.
        
        ## How it works
        
        The template uses Zabbix Agent 2 disk discovery to identify storage devices\. A custom master item retrieves the full SMART JSON output using `smartctl -x -j`, which is processed into standardised fields such as drive model, serial number, capacity, health status, temperature and power\-on hours\. These can then be used for dependent items and triggers\.
        
        ## Host Prerequisites
        
        - Install `sudo` and `smartmontools`\.
        - Configure Zabbix Agent 2 with the SMART plugin path:
          `Plugins.Smart.Path=/usr/sbin/smartctl`
        - Grant the `zabbix` user passwordless sudo permission to run smartctl\.
        - Create `/etc/sudoers.d/zabbix-smartctl` containing:
          `zabbix ALL=(ALL) NOPASSWD: /usr/sbin/smartctl`
        - Set the sudoers file permissions to `0440` and validate using `visudo -c`\.
        - Install the custom collection script:
          `/usr/local/bin/zabbix-smart-full.sh`
        - Configure the Agent 2 UserParameter:
          `smart.full.get[*]`
        
        The collection script executes smartctl with elevated privileges, validates the returned JSON and outputs normalised SMART data for Zabbix to process\.
      groups:
        - name: Storage
        - name: Templates
      discovery_rules:
        - uuid: 5ebf783144294e5dbe79ad8ef313525b
          name: 'SMART Disk Discovery'
          type: ZABBIX_ACTIVE
          key: 'smart.disk.discovery[name]'
          delay: 1h
          filter:
            conditions:
              - macro: '{#NAME}'
                value: '.*iStorage_diskAshur2.*'
                operator: NOT_MATCHES_REGEX
                formulaid: A
          description: 'Automatically discovers SAS, SATA and NVMe drives using Zabbix Agent 2 SMART discovery. Forms the basis for automatic SMART monitoring through the custom JSON collector, with SAS compatibility extending the capabilities of the legacy SMART template.'
          item_prototypes:
            - uuid: d14b92e747c04e3ab45dcff1f2ede6a7
              name: 'SMART Exit_Status- {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.attribute.exit_status[{#NAME}]'
              delay: '0'
              description: 'Returns the exit code reported by smartctl after the SMART data collection process. A value of 0 indicates a successful execution.'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.raw.smartctl.exit_status
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 154aaca12b9248b899260e2003cce24f
              name: 'SMART Power_on_Hours- {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.attribute.power_on_hours[{#NAME}]'
              delay: '0'
              description: 'Displays the total powered on hours for this device.'
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var data = JSON.parse(value);
                      
                      if (data.protocol === "NVMe") {
                          return data.raw.nvme_smart_health_information_log.power_on_hours;
                      }
                      
                      return data.power_on_hours;
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: fc5cccf8c7a543bf9f1a57705d9f455a
              name: 'SMART Smart_Status- {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.attribute.smart_status[{#NAME}]'
              delay: '0'
              description: 'Returns the smart status passed or failed reported by smartctl after the SMART data collection process. A value of 0 indicates a successful execution.'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.smart_status.passed
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 3b79859d2c6d4d4182a28555ac8ab893
              name: 'SMART Capacity - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.capacity[{#NAME}]'
              delay: '0'
              units: B
              description: 'Displays serial number of detected drive.'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.capacity_bytes
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 7b48c7cb09494152a8c43f53b2ce54ec
              name: 'SMART Health - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.health["{#PATH}"]'
              delay: '0'
              value_type: TEXT
              trends: '0'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.health
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 4025d4d2b3634b889aa0b20d222376dc
              name: 'SMART Model - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.model[{#NAME}]'
              delay: '0'
              value_type: TEXT
              trends: '0'
              description: 'Displays model name of detected drive.'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.model
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 48ad7a5d1ff7407fb767131d63539ad4
              name: 'SMART Protocol - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.protocol[{#NAME}]'
              delay: '0'
              value_type: TEXT
              trends: '0'
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var data = JSON.parse(value);
                      
                      return data.protocol;
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 220e65167d874d0e82f7de166cf0d8b6
              name: 'SMART Serial Number - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.serial[{#NAME}]'
              delay: '0'
              value_type: TEXT
              trends: '0'
              description: 'Displays serial number of detected drive.'
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.serial
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: cc3f6688db864675aeb4d95166cc1dd2
              name: 'SMART Temperature - {#NAME}'
              type: DEPENDENT
              key: 'smart.disk.temperature["{#PATH}"]'
              delay: '0'
              units: °C
              preprocessing:
                - type: JSONPATH
                  parameters:
                    - $.temperature
                - type: DISCARD_UNCHANGED_HEARTBEAT
                  parameters:
                    - 6h
              master_item:
                key: 'smart.full.get["{#PATH}"]'
              tags:
                - tag: component
                  value: storage
                - tag: function
                  value: smart_data
            - uuid: 6c60e7dfc3204136a3f50a19eb05d2a7
              name: 'SMART Full JSON - {#NAME}'
              type: ZABBIX_ACTIVE
              key: 'smart.full.get["{#PATH}"]'
              history: 1d
              value_type: TEXT
              trends: '0'
              tags:
                - tag: component
                  value: storage
                - tag: type
                  value: smart_raw
